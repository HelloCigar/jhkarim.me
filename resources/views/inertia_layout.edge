<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title inertia>
      AdonisJS
    </title>
    <script>
      ;(function () {
        var theme = localStorage.getItem('theme')
        if (theme !== 'light') document.documentElement.classList.add('dark')
      })()
    </script>

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>
  <body class="relative bg-base color-base">
    @inertia({ class: 'isolate relative flex min-h-svh flex-col' })
  </body>
</html>
